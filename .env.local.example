# Copy this file to .env.local and fill in real values.
# Get the Supabase values from: your project → Settings → API

# Safe to expose to the browser (used by the public site)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET, server-only, bypasses Row Level Security. Never commit this
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin dashboard. Choose something you'll remember:
# it's the only thing protecting message approval and the RSVP list.
ADMIN_PASSWORD=choose-a-strong-password

# --- Telegram photo bot ---
# Public link guests tap to open the bot (shown on the "Share your photos" button)
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot_username
# SECRET: the token BotFather gave you
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# SECRET: any long random text you make up (protects the webhook)
TELEGRAM_WEBHOOK_SECRET=make-up-a-long-random-string
# The private group where guest photos arrive (see README for how to find it)
TELEGRAM_GROUP_CHAT_ID=-1001234567890
# Your live address (also used for link previews)
NEXT_PUBLIC_SITE_URL=https://tiraandlydu.com
