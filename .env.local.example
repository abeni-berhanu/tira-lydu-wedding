# Copy this file to .env.local and fill in real values.
# Get the Supabase values from: your project → Settings → API

# Safe to expose to the browser (used by the public site)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only, bypasses Row Level Security. Never commit this
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin dashboard. Choose something you'll remember —
# it's the only thing protecting message approval and the RSVP list.
ADMIN_PASSWORD=choose-a-strong-password
